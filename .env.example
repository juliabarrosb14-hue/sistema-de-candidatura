# Senha de acesso ao painel do RH
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-este-segredo-por-uma-string-aleatoria-longa

# Upload de currículo
MAX_RESUME_SIZE_MB=8

# Google Apps Script — OBRIGATÓRIO
# O app usa uma planilha do Google (via Apps Script) como banco de dados e o
# Google Drive da mesma conta para guardar os currículos. Não usa Google Cloud
# Console nem exige cartão de crédito — veja o passo a passo no README.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
